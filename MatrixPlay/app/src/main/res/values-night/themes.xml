<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MatrixPlay" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="android:windowBackground">@color/dark_black</item>
    </style>

    <style name="style_btn">
        <item name="android:backgroundTint">@color/dark_blue</item>
        <item name="android:textColor">@color/dark_gray</item>
        <item name="strokeColor">@color/dark_purple</item>
    </style>

    <style name="style_title_shadows">
        <item name="android:textColor">@color/dark_gray</item>
        <item name="android:shadowColor">@color/dark_gray</item>
    </style>
    <style name="style_title_foreground">
        <item name="android:textColor">@color/dark_yellow</item>
    </style>

    <style name="style_cardview">
        <item name="android:backgroundTint">@color/dark_gray</item>
    </style>
    <style name="style_cardview_title">
        <item name="android:textColor">@color/dark_green</item>
    </style>
    <style name="style_cardview_title_shadows">
        <item name="android:textColor">@color/dark_green</item>
        <item name="android:shadowColor">@color/dark_yellow</item>
    </style>
    <style name="style_cardview_input">
        <item name="boxStrokeColor">@color/dark_purple</item>
        <item name="hintTextColor">@color/dark_purple</item>
        <item name="android:textColorHint">@color/dark_black</item>
        <item name="cursorColor">@color/dark_blue</item>
    </style>
    <style name="style_cardview_inputtextfield">
        <item name="android:textColor">@color/dark_blue</item>
        <item name="android:textColorHint">@color/dark_black</item>
    </style>

    <style name="style_wait_versus">
        <item name="android:textColor">@color/dark_blue</item>
    </style>

    <style name="style_wait_player1">
        <item name="android:textColor">@color/red</item>
    </style>
    <style name="style_wait_player2">
        <item name="android:textColor">@color/dark_gray</item>
    </style>

    <style name="style_pad_p1">
        <item name="android:thumbTint">@color/red</item>
    </style>
    <style name="style_pad_p2">
        <item name="android:thumbTint">@color/dark_gray</item>
    </style>
</resources>