<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MatrixPlay" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowBackground">@color/gray</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.MatrixPlay" parent="Base.Theme.MatrixPlay" />

    <style name="style_btn">
        <item name="android:backgroundTint">@color/green</item>
        <item name="android:textColor">@color/black</item>
        <item name="strokeColor">@color/yellow</item>
    </style>

    <style name="style_title_shadows">
        <item name="android:textColor">@color/black</item>
        <item name="android:shadowColor">@color/black</item>
    </style>
    <style name="style_title_foreground">
        <item name="android:textColor">@color/yellow</item>
    </style>

    <style name="style_cardview">
        <item name="android:backgroundTint">@color/purple</item>
    </style>
    <style name="style_cardview_title">
        <item name="android:textColor">@color/gray</item>
    </style>
    <style name="style_cardview_title_shadows">
        <item name="android:textColor">@color/black</item>
        <item name="android:shadowColor">@color/black</item>
    </style>
    <style name="style_cardview_input">
        <item name="boxStrokeColor">@color/gray</item>
        <item name="hintTextColor">@color/gray</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="cursorColor">@color/yellow</item>
    </style>
    <style name="style_cardview_inputtextfield">
        <item name="android:textColor">@color/yellow</item>
        <item name="android:textColorHint">@color/black</item>
    </style>

    <style name="style_wait_versus">
        <item name="android:textColor">@color/green</item>
    </style>

    <style name="style_wait_player1">
        <item name="android:textColor">@color/red</item>
    </style>
    <style name="style_wait_player2">
        <item name="android:textColor">@color/blue</item>
    </style>

    <style name="style_pad_p1">
        <item name="android:thumbTint">@color/red</item>

    </style>
    <style name="style_pad_p2">
        <item name="android:thumbTint">@color/blue</item>
    </style>


</resources>