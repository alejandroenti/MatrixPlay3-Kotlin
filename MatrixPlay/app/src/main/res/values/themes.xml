<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MatrixPlay" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowBackground">@color/light_gray</item>
    </style>

    <style name="Theme.MatrixPlay" parent="Base.Theme.MatrixPlay" />

    <style name="style_btn">
        <item name="android:backgroundTint">@color/light_purple</item>
        <item name="android:textColor">@color/light_gray</item>
        <item name="strokeColor">@color/light_blue</item>
    </style>

    <style name="style_title_shadows">
        <item name="android:textColor">@color/light_black</item>
        <item name="android:shadowColor">@color/light_black</item>
    </style>
    <style name="style_title_foreground">
        <item name="android:textColor">@color/light_yellow</item>
    </style>

    <style name="style_cardview">
        <item name="android:backgroundTint">@color/light_purple</item>
    </style>
    <style name="style_cardview_title">
        <item name="android:textColor">@color/light_gray</item>
    </style>
    <style name="style_cardview_title_shadows">
        <item name="android:textColor">@color/dark_black</item>
        <item name="android:shadowColor">@color/light_black</item>
    </style>
    <style name="style_cardview_input">
        <item name="boxStrokeColor">@color/light_gray</item>
        <item name="hintTextColor">@color/light_gray</item>
        <item name="android:textColorHint">@color/light_black</item>
        <item name="cursorColor">@color/light_yellow</item>
    </style>
    <style name="style_cardview_inputtextfield">
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:textColorHint">@color/light_black</item>
    </style>
</resources>